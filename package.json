{
  "name": "mindtrace",
  "productName": "知迹 MindTrace",
  "version": "1.0.0",
  "description": "桌面行为智能采集与个人知识资产系统",
  "main": "src/main/main.js",
  "author": "MindTrace",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.mindtrace.app",
    "productName": "知迹MindTrace",
    "copyright": "Copyright © 2026 MindTrace",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "MindTrace-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "dir"],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "2052"
    },
    "portable": {
      "artifactName": "MindTrace-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dayjs": "^1.11.13",
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.12.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
