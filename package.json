{
  "name": "mindtrace",
  "productName": "知迹 MindTrace",
  "version": "2.0.0",
  "description": "全景个人计算活动采集与 LLM Wiki 知识资产系统",
  "main": "src/main/main.js",
  "author": "MindTrace",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "pack": "electron-builder --dir",
    "test:e2e": "electron scripts/e2e-ai-test.js --no-sandbox",
    "mock:ai": "node scripts/mock-openai-server.js 3921",
    "shots": "electron . --dev --screenshot-tour --no-sandbox --user-data-dir=/tmp/mindtrace-shots",
    "test:perf": "electron scripts/e2e-perf-10k.js --no-sandbox"
  },
  "build": {
    "appId": "com.mindtrace.app",
    "productName": "知迹 MindTrace",
    "copyright": "Copyright © 2026 MindTrace",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "MindTrace-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "MindTrace-${version}-${os}-${arch}.${ext}",
      "desktop": {
        "Name": "知迹 MindTrace",
        "Comment": "桌面行为智能采集与个人知识资产系统",
        "Categories": "Utility;"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "知迹 MindTrace",
      "artifactName": "MindTrace-${version}-setup.${ext}",
      "unicode": true,
      "perMachine": false,
      "allowElevation": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "MindTrace-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
